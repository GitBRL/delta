APP_NAME=Delta
APP_ENV=local
APP_KEY=
# Passkeys (ADR 0025): fixe antes de girar a APP_KEY, senão as passkeys cadastradas param de funcionar.
PASSKEYS_USER_HANDLE_SECRET=
# PASSKEYS_RP_ID= (padrão: domínio de FRONTEND_URL)
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4300

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Senhas NÃO ficam aqui: o compose injeta DB_PASSWORD, DB_OWNER_PASSWORD e REDIS_PASSWORD
# a partir do .env da raiz (gerado por bin/setup-env).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=delta
DB_USERNAME=delta_app
DB_OWNER_USERNAME=delta_owner
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:4300,127.0.0.1:4300,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="nao-responda@delta.local"
MAIL_FROM_NAME="${APP_NAME}"

# Login real das plataformas: PADRÃO OPCIONAL do servidor. O normal é cada agência cadastrar
# o próprio app na tela Integrações › Apps das plataformas (ADR 0009), que tem precedência.
# Redirect a cadastrar nos apps: ${FRONTEND_URL}/oauth/<plataforma>/callback
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202410

# PDF dos relatórios (serviço gotenberg do compose)
GOTENBERG_URL=http://gotenberg:3000

# Copiloto de IA (opcional): padrão do servidor; cada agência pode cadastrar a sua na tela.
ANTHROPIC_API_KEY=
